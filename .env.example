# ==========================================================
# KONFIGURASI ENVIRONMENT VARIABLE WEBSITE PERKAB KKN
# ==========================================================
# File ini digunakan untuk melakukan setup koneksi database
# Supabase Cloud saat hosting (Vercel, Netlify, Railway, VPS, dll).
#
# Salin/copy file ini menjadi `.env` di komputer lokal Anda,
# atau masukkan kunci ini pada Environment Variables di dashboard Hosting.

# 1. URL Project Supabase
# Temukan di Dashboard Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# 2. Anon Public API Key Supabase
# Temukan di Dashboard Supabase -> Project Settings -> API -> Project API Keys (anon/public)
VITE_SUPABASE_ANON_KEY=
